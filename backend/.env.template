STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# ── GoShip (vận chuyển) ──────────────────────────────────────────────────
# Token sandbox/prod lấy từ my.goship.io. Khi go-live đổi base_url sang
# https://api.goship.io/api/v2 và dùng token production. Nên rotate cả
# token + secret nếu từng bị lộ.
GOSHIP_BASE_URL=https://sandbox.goship.io/api/v2
GOSHIP_TOKEN=
GOSHIP_CLIENT_ID=
GOSHIP_CLIENT_SECRET=
# Tier mặc định + mức phí dự phòng (VND) khi chưa gọi được bảng giá GoShip.
GOSHIP_DEFAULT_SERVICE=economy
GOSHIP_FALLBACK_FEE=30000

# ── Bật/tắt GoShip ───────────────────────────────────────────────────────
# Nguồn chính là bảng `goship_setting` (bật/tắt ngay trong Admin → GoShip).
# `GOSHIP_ENABLED` chỉ là giá trị DỰ PHÒNG khi DB chưa có dòng nào.
# Bỏ trống / false = TẮT: checkout chỉ dùng 2 option `flat` (giá cố định).
# true = BẬT: hiện thêm 2 option GoShip "Tiết kiệm"/"Nhanh" do /rates tính cước.
GOSHIP_ENABLED=false
# Điểm gửi (mã GoShip 3 cấp) — mặc định Kho HCM (HCM / Bình Tân / Tân Tạo A).
GOSHIP_ORIGIN_CITY=700000
GOSHIP_ORIGIN_DISTRICT=701900
GOSHIP_ORIGIN_WARD=9276
# Liên hệ điểm gửi (in trên vận đơn) + ai trả phí (0 = khách, 1 = shop).
GOSHIP_ORIGIN_NAME=Kho HCM
GOSHIP_ORIGIN_PHONE=0900000000
GOSHIP_ORIGIN_ADDRESS=1 Tân Tạo A
GOSHIP_PAYER=1
# Tiền thu hộ mặc định khi tạo vận đơn (0 = không COD).
GOSHIP_COD_DEFAULT=0
# Kiện hàng mặc định khi variant thiếu cân nặng/kích thước.
# Số dưới đây tính theo đơn vị ở GOSHIP_WEIGHT_UNIT / GOSHIP_DIMENSION_UNIT.
GOSHIP_DEFAULT_WEIGHT_GRAMS=500
GOSHIP_DEFAULT_LENGTH_CM=20
GOSHIP_DEFAULT_WIDTH_CM=15
GOSHIP_DEFAULT_HEIGHT_CM=10
# Đơn vị shop nhập ở Medusa (Medusa không có cấu hình đơn vị). GoShip luôn nhận
# gram + cm; hệ thống tự quy đổi. Dự phòng — Admin → GoShip ghi đè.
GOSHIP_WEIGHT_UNIT=g
GOSHIP_DIMENSION_UNIT=cm
# "Giao 1 phần" mặc định (dự phòng; Admin → GoShip ghi đè). Chỉ GHN/GHTK.
GOSHIP_PART_DELIVERY=false
