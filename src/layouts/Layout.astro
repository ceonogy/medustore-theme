---
import heroImage from "@assets/hero.png";
import { useTranslations } from "@i18n";
import { getRegion } from "@lib/data/regions";
import { CartSidebar } from "@modules/layout/components/CartSidebar";
import Footer from "@modules/layout/components/Footer.astro";
import { Nav } from "@modules/layout/components/Nav";
import albertSansLatin400 from "@fontsource/albert-sans/files/albert-sans-latin-400-normal.woff2?url";
import albertSansLatinExt400 from "@fontsource/albert-sans/files/albert-sans-latin-ext-400-normal.woff2?url";
import "@fontsource/albert-sans/400.css";
import "@fontsource/albert-sans/500.css";
import "@fontsource/albert-sans/700.css";
import "@fontsource/albert-sans/900.css";
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "product";
  noindex?: boolean;
  /* Extra woff2 subsets to preload (e.g. the 900 display weight on the
     homepage hero). Kept opt-in per page so routes that never render
     weight-900 text don't download it. */
  preloadFonts?: string[];
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  preloadFonts = [],
} = Astro.props;

const { locale, countryCode } = Astro.locals;
const t = useTranslations(locale);

const siteName = t("site.name");
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const metaDescription = description ?? t("site.description");
// Filter, sort and campaign variants all canonicalise to the clean path;
// `?page=N` is the single parameter that canonicalises to itself (page 1 is
// removed from links, so it never appears in a canonical URL either).
const pageParam = Astro.url.searchParams.get("page");
const canonicalPath =
  Astro.url.pathname +
  (pageParam && pageParam !== "1" && /^\d+$/.test(pageParam)
    ? `?page=${pageParam}`
    : "");
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);

// Social crawlers only read absolute image URLs: every page gets the brand
// hero when it has none of its own (product pages pass their first photo).
const socialImage = new URL(
  image ?? heroImage.src,
  Astro.site ?? Astro.url.origin,
).href;

const region = await getRegion(countryCode);
const regionId = region?.id || null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      /* Marks that JS is alive before first paint: the scroll-reveal hidden
        state is scoped to `.has-reveal`, so a page without JS renders fully
        visible instead of stuck at opacity 0.001. */
    }
    <script is:inline>
      document.documentElement.classList.add("has-reveal");
    </script>
    {
      /* On-demand motion diagnostic: `?motion=1` renders a small badge
         reporting the three states that decide whether the hero entrance
         can play — the keyframes resolving (`animation-name` on the
         masked headline), the browser's reduced-motion preference, and
         whether the head script ran. Debugging aid only: invisible
         unless asked for; a missing badge itself means scripts are off.
         The scroll-reveal gate above is unrelated to the hero entrance,
         which is pure CSS. */
    }
    <script is:inline>
      if (new URLSearchParams(location.search).has("motion")) {
        addEventListener("DOMContentLoaded", () => {
          const el = document.querySelector(".hero-line-in");
          const anim = el
            ? getComputedStyle(el).animationName
            : "element missing";
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const gate =
            document.documentElement.classList.contains("has-reveal");
          const cssOk = anim.includes("hero-line-up");
          const badge = document.createElement("div");
          badge.style.cssText =
            "position:fixed;left:12px;bottom:12px;z-index:2147483647;padding:10px 14px;" +
            "font:600 12px/1.7 ui-monospace,monospace;color:#fff;border-radius:8px;" +
            "background:" +
            (cssOk ? "#111" : "#b91c1c") +
            ";box-shadow:0 6px 24px rgb(0 0 0 / 0.25)";
          badge.innerHTML =
            "MOTION DEBUG<br>" +
            "js: on (this badge needs scripts)<br>" +
            "css animation-name: " +
            anim +
            (cssOk ? " OK" : "  <-- CSS NOT APPLIED") +
            "<br>" +
            "prefers-reduced-motion: " +
            (reduce ? "YES -> entrance skipped by design" : "no") +
            "<br>" +
            "head script: " +
            (gate ? "ran" : "did not run");
          document.body.append(badge);
        });
      }
    </script>
    {
      /* Body copy (weight 400) ships in two subsets — Vietnamese mixes
        latin ASCII with latin-ext diacritics — so both woff2s are
        preloaded: first paint shouldn't wait on the CSS → @font-face →
        fetch chain. `?url` imports keep the preload pointing at the
        hashed asset. */
    }
    <link
      rel="preload"
      href={albertSansLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={albertSansLatinExt400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadFonts.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }
    <link
      rel="dns-prefetch"
      href="//medusa-public-images.s3.eu-west-1.amazonaws.com"
    />
    <link
      rel="preconnect"
      href="https://medusa-public-images.s3.eu-west-1.amazonaws.com"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl.href} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <Nav
      client:load
      locale={locale}
      regionId={regionId}
      currentPath={Astro.url.pathname}
    />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CartSidebar client:load locale={locale} />
    <script>
      import "@lib/reveal";
    </script>
  </body><style>
    body {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
    }
  </style>
</html>
