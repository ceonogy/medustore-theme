---
import { Image } from "astro:assets";
import { localizePath, useTranslations } from "@i18n";
import { getProductPrice } from "../../../../lib/utils/get-product-price";
import type { ProductVariant } from "../../../../types/global";
import PlaceholderImage from "../thumbnail/PlaceholderImage.astro";
import Price from "./Price.astro";

interface Props {
  handle: string;
  variants: ProductVariant[];
  thumbnailUrl?: string;
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { handle, variants, thumbnailUrl, imageUrl, title, priority } =
  Astro.props;

// The store page renders this card without a locale prop, so read it from the
// request context Astro exposes to every component.
const locale = Astro.locals.locale;
const t = useTranslations(locale);

const { cheapestPrice } = getProductPrice({
  productVariants: variants,
});

const image = thumbnailUrl || imageUrl;
---

<a
  href={localizePath(locale, `/store/${handle}`)}
  class="product group flex h-full flex-col gap-4"
>
  {/* square media + hover CTA, matching the reference template's cards */}
  <div class="product-media">
    {
      image ? (
        <Image
          src={image}
          width={512}
          height={512}
          alt={title || t("products.thumbnail.imageAlt")}
          widths={[256, 384, 512]}
          sizes="(max-width: 809px) 50vw, (max-width: 1439px) 33vw, 25vw"
          format="webp"
          quality={45}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          class="h-full w-full object-cover"
        />
      ) : (
        <span class="flex h-full w-full items-center justify-center text-muted">
          <PlaceholderImage size={24} />
        </span>
      )
    }
    <span class="product-cta">{t("home.viewProduct")}</span>
  </div>

  <div class="flex items-start justify-between gap-3 text-sm">
    <p class="font-medium leading-snug">{title}</p>
    {
      cheapestPrice && (
        <div class="shrink-0 text-right">
          <Price
            priceType={cheapestPrice.price_type ?? ""}
            originalPrice={cheapestPrice.original_price}
            calculatedPrice={cheapestPrice.calculated_price}
          />
        </div>
      )
    }
  </div>
</a>
