---
import { useTranslations } from "@i18n";

interface Props {
  priceType: string;
  originalPrice: string;
  calculatedPrice: string;
}

const { priceType, originalPrice, calculatedPrice } = Astro.props;

const t = useTranslations(Astro.locals.locale);
---

<>
  {
    priceType === "sale" && (
      <p data-testid="original-price">
        <span class="sr-only">{t("products.price.original")}</span>
        {originalPrice}
      </p>
    )
  }
  <p data-testid="price">
    <span class="sr-only">{t("products.price.current")}</span>
    {calculatedPrice}
  </p>
</>
