---
import { useTranslations, type Locale } from "@i18n";

interface Props {
  material?: string | null;
  origin_country?: string | null;
  type?: { value: string } | null;
  weight?: number | null;
  length?: number | null;
  width?: number | null;
  height?: number | null;
  /** Đơn vị shop khai ở Admin → GoShip; chỉ để hiện nhãn. Mặc định g/cm. */
  weightUnit?: string;
  dimensionUnit?: string;
  locale: Locale;
}

const {
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
  weightUnit = "g",
  dimensionUnit = "cm",
  locale,
} = Astro.props;

const t = useTranslations(locale);

// Medusa stores the origin as an ISO 3166-1 alpha-2 code; show the country
// name in the active language ("VN" → "Việt Nam" / "Vietnam").
const countryName = (() => {
  if (!origin_country) return null;
  const code = origin_country.trim().toUpperCase();
  try {
    return new Intl.DisplayNames([locale], { type: "region" }).of(code) ?? code;
  } catch {
    return code;
  }
})();

// Dimension string, e.g. "32 × 26 × 6 cm"; weight, e.g. "500 g". Medusa stores
// bare numbers, so the unit comes from the shop's GoShip setting.
const dimensions =
  length && width && height
    ? `${length} × ${width} × ${height} ${dimensionUnit}`
    : null;
const weightLabel = weight ? `${weight} ${weightUnit}` : null;
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <div class="grid grid-cols-2 gap-x-8">
    <div class="flex flex-col gap-y-4">
      <div>
        <span class="font-semibold">{t("products.attributes.material")}</span>
        <p>{material || "-"}</p>
      </div>
      <div>
        <span class="font-semibold"
          >{t("products.attributes.countryOfOrigin")}</span
        >
        <p>{countryName || "-"}</p>
      </div>
      <div>
        <span class="font-semibold">{t("products.attributes.type")}</span>
        <p>{type?.value || "-"}</p>
      </div>
    </div>

    <div class="flex flex-col gap-y-4">
      <div>
        <span class="font-semibold">{t("products.attributes.weight")}</span>
        <p>{weightLabel || "-"}</p>
      </div>
      <div>
        <span class="font-semibold">{t("products.attributes.dimensions")}</span>
        <p>{dimensions || "-"}</p>
      </div>
    </div>
  </div>
</div>
