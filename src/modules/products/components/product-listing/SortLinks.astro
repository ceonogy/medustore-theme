---
import { useTranslations } from "@i18n";
import {
  SORT_VALUES,
  resolveCanonical,
  type CatalogState,
  type PageType,
  type SortValue,
} from "@lib/utils/canonical-query";

interface Props {
  basePath: string;
  pageType: PageType;
  state: CatalogState;
}

const { basePath, pageType, state } = Astro.props;
const { locale } = Astro.locals;
const t = useTranslations(locale);

const labels: Record<SortValue, string> = {
  newest: t("products.sort.newest"),
  price_asc: t("products.sort.priceAsc"),
  price_desc: t("products.sort.priceDesc"),
};

/** Real links: sorting is a server round-trip, not a client-side re-order. */
const hrefFor = (sort: SortValue): string => {
  const target = resolveCanonical({
    pageType,
    path: basePath,
    state: { ...state, sort: sort === "newest" ? null : sort, page: null },
  });
  return `${target.path}${target.search}`;
};

const current: SortValue = state.sort ?? "newest";
---

<nav
  aria-label={t("products.sort.label")}
  class="flex flex-wrap items-center gap-2"
>
  <span class="type-body mr-1 text-muted">{t("products.sort.label")}</span>
  {
    SORT_VALUES.map((sort) => (
      <a
        href={hrefFor(sort)}
        aria-current={current === sort ? "true" : undefined}
        class={`flex min-h-10 items-center rounded-md border px-4 text-sm transition-colors ${
          current === sort
            ? "border-ink bg-ink text-paper"
            : "border-line hover:border-ink"
        }`}
      >
        {labels[sort]}
      </a>
    ))
  }
</nav>
