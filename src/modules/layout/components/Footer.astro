---
import { localizePath, useTranslations, type Locale } from "@i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const shopLinks = [
  { href: localizePath(locale, "/"), label: t("footer.home") },
  { href: localizePath(locale, "/store"), label: t("footer.allProducts") },
  { href: localizePath(locale, "/cart"), label: t("footer.cart") },
  { href: localizePath(locale, "/checkout"), label: t("footer.checkout") },
];

const companyLinks = [
  { href: localizePath(locale, "/privacy"), label: t("footer.privacy") },
  { href: localizePath(locale, "/terms"), label: t("footer.terms") },
  {
    href: "https://github.com/Bystrol/astro-medusa-starter",
    label: "GitHub",
    external: true,
  },
];
---

<footer class="border-t border-black/10 bg-stone-50">
  <div class="px-8 py-14 md:px-12 lg:px-16">
    <div
      class="grid gap-10 border-b border-black/10 pb-10 md:grid-cols-2 xl:grid-cols-[1.2fr_0.8fr_0.8fr_1fr]"
    >
      <section class="max-w-md">
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-black/55"
        >
          {t("footer.eyebrow")}
        </p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-black">
          {t("footer.headline")}
        </h2>
        <p class="mt-4 text-sm leading-6 text-black/65">
          {t("footer.description")}
        </p>
      </section>

      <nav aria-label={t("footer.navShop")}>
        <p class="text-sm font-semibold text-black">{t("footer.shop")}</p>
        <ul class="mt-4 space-y-3 text-sm text-black/65">
          {
            shopLinks.map((link) => (
              <li>
                <a class="transition hover:text-black" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t("footer.navCompany")}>
        <p class="text-sm font-semibold text-black">{t("footer.company")}</p>
        <ul class="mt-4 space-y-3 text-sm text-black/65">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  class="transition hover:text-black"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section>
        <p class="text-sm font-semibold text-black">
          {t("footer.customerCare")}
        </p>
        <div class="mt-4 space-y-4 text-sm text-black/65">
          <p>{t("footer.customerCareText")}</p>
          <a
            class="inline-flex rounded-full bg-black px-5 py-3 text-sm font-medium text-white transition hover:bg-black/85"
            href={localizePath(locale, "/store")}
          >
            {t("footer.startShopping")}
          </a>
        </div>
      </section>
    </div>

    <p class="text-sm text-black/55 pt-6">
      {t("footer.copyright", { year: currentYear })}
    </p>
  </div>
</footer>
