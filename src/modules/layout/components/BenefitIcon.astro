---
interface Props {
  name: "shipping" | "refund" | "support" | "secure";
}

const { name } = Astro.props;
---

<svg
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "shipping" && (
      <>
        <path d="M3 6h10v9H3z" />
        <path d="M13 9h4l4 3v3h-8z" />
        <circle cx="7.5" cy="17.5" r="1.8" />
        <circle cx="17" cy="17.5" r="1.8" />
      </>
    )
  }
  {
    name === "refund" && (
      <>
        <path d="M20 12a8 8 0 1 1-2.3-5.6" />
        <path d="M20 4v4h-4" />
      </>
    )
  }
  {
    name === "support" && (
      <>
        <path d="M5 13v-2a7 7 0 0 1 14 0v2" />
        <path d="M5 13h3v6H6a1 1 0 0 1-1-1z" />
        <path d="M19 13h-3v6h2a1 1 0 0 0 1-1z" />
      </>
    )
  }
  {
    name === "secure" && (
      <>
        <path d="M8 11V8a4 4 0 0 1 8 0v3" />
        <rect x="5" y="11" width="14" height="9" rx="2" />
      </>
    )
  }
</svg>
