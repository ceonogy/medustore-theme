---
import { useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { listProducts } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { buildFilterGroups } from "@lib/utils/product-filters";
import ProductPreview from "@modules/products/components/product-preview/ProductPreview.astro";
import { ProductFilters } from "@modules/products/components/product-filters/ProductFilters";

const { locale, countryCode } = Astro.locals;
const t = useTranslations(locale);

const region = await getRegion(countryCode);

if (!region) {
  return Astro.redirect("/not-found");
}

let products: Awaited<ReturnType<typeof listProducts>> = [];
let error: Error | undefined;

try {
  products = await listProducts(region.id);
} catch (e) {
  error = e instanceof Error ? e : new Error(t("common.unknownError"));
  console.error(error);
}

const filterGroups = buildFilterGroups(products);

// Only the fields the island actually needs — keeps the serialised payload small.
const filterableProducts = products.map((product) => ({
  id: product.id,
  categories: product.categories?.map(({ id, name }) => ({ id, name })) ?? [],
  collection: product.collection
    ? { id: product.collection.id, title: product.collection.title }
    : null,
}));
---

<Layout title={t("store.title")} description={t("store.description")}>
  <div class="px-8 py-6 md:px-12 lg:px-16">
    <h1 class="mb-8 text-4xl font-bold">{t("store.title")}</h1>
    {error && <p class="text-red-700">{error.message}</p>}
    <ProductFilters
      client:load
      products={filterableProducts}
      groups={filterGroups}
    />
    <ul
      aria-label={t("store.productsLabel")}
      class="grid lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 w-full gap-x-6 gap-y-8"
    >
      {
        products?.map((product, index) => (
          <li data-product-id={product.id}>
            <ProductPreview
              id={product.id}
              variants={product.variants ?? []}
              thumbnailUrl={product.thumbnail ?? undefined}
              imageUrl={product.images?.[0]?.url}
              title={product.title}
              priority={index < 4}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
