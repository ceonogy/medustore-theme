---
import { useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { buildListing } from "@lib/data/catalog";
import { getRegion } from "@lib/data/regions";
import { itemListJsonLd } from "@lib/utils/seo";
import JsonLd from "@modules/layout/components/JsonLd.astro";
import NotFoundNotice from "@modules/layout/components/NotFoundNotice.astro";
import ProductListing from "@modules/products/components/product-listing/ProductListing.astro";

const { locale, countryCode } = Astro.locals;
const t = useTranslations(locale);

let listing: Awaited<ReturnType<typeof buildListing>> | undefined;

try {
  const region = await getRegion(countryCode);
  if (!region) {
    throw new Error(`No region resolves market "${countryCode}"`);
  }
  // The middleware already canonicalised the query string, so this renders the
  // filter state it validated (or the unfiltered page when there is none).
  listing = await buildListing(region.id, Astro.url.search, { locale });
} catch (error) {
  // Medusa unreachable is a temporary failure, never a 404.
  console.error(error);
  return new Response(t("common.serviceUnavailable"), {
    status: 503,
    headers: {
      "Retry-After": "30",
      "Content-Type": "text/plain; charset=utf-8",
    },
  });
}

// `?page=N` past the last page is a real 404, not an empty listing.
if (listing.beyond) {
  Astro.response.status = 404;
}

const origin = Astro.site?.origin ?? Astro.url.origin;
// The grid's current page, as the crawler-visible list of product URLs.
const structuredData = listing.beyond
  ? null
  : itemListJsonLd(
      listing.products.map((product) => ({
        name: product.title,
        path: `/store/${product.handle}`,
      })),
      origin,
    );
---

<Layout
  title={t("store.title")}
  description={t("store.description")}
  noindex={listing.beyond}
>
  {structuredData && <JsonLd data={structuredData} />}
  <div class="wrap section">
    <h1 class="type-display mb-8">{t("store.title")}</h1>
    {
      listing.beyond ? (
        <NotFoundNotice />
      ) : (
        <ProductListing
          products={listing.products}
          suggestions={listing.suggestions}
          groups={listing.groups}
          optionLabels={listing.optionLabels}
          state={listing.state}
          pageType="store"
          basePath="/store"
          totalCount={listing.totalCount}
          page={listing.page}
          pageCount={listing.pageCount}
          priceBounds={listing.priceBounds}
        />
      )
    }
  </div>
</Layout>
