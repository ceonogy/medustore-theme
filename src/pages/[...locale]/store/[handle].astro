---
import { useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { ResourceNotFoundError, retrieveProduct } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { getTaxonomy } from "@lib/data/taxonomy";
import { getProductPrice } from "@lib/utils/get-product-price";
import NotFoundNotice from "@modules/layout/components/NotFoundNotice.astro";
import ImageCarouselWrapper from "@modules/products/components/product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "@modules/products/components/product-details/ProductActions";
import ProductAttributes from "@modules/products/components/product-details/ProductAttributes.astro";

const { locale, countryCode } = Astro.locals;
// The route segment is the product's SEO handle, e.g. `/store/ao-so-mi-caro-co-dien`.
const { handle: productRef } = Astro.params;
const t = useTranslations(locale);

const unavailable = () =>
  new Response(t("common.serviceUnavailable"), {
    status: 503,
    headers: {
      "Retry-After": "30",
      "Content-Type": "text/plain; charset=utf-8",
    },
  });

if (!productRef) {
  return new Response("Not Found", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}

const region = await getRegion(countryCode).catch((regionError) => {
  console.error(regionError);
  return null;
});

if (!region) {
  // No region means the backend is not answering with data — not a dead URL.
  return unavailable();
}

let product: Awaited<ReturnType<typeof retrieveProduct>> | undefined;
let error: Error | undefined;

try {
  product = await retrieveProduct(productRef, region.id);
} catch (e) {
  if (!(e instanceof ResourceNotFoundError)) {
    console.error(e);
    return unavailable();
  }

  // A renamed handle keeps its old URL alive: 301 onto the current one.
  try {
    const taxonomy = await getTaxonomy();
    const legacy = taxonomy.legacy.product.get(productRef);
    if (legacy) return Astro.redirect(`/store/${legacy}`, 301);
  } catch (taxonomyError) {
    console.error(taxonomyError);
  }

  error = e;
  Astro.response.status = 404;
}

// Links published with the raw id keep working — permanently moved onto the
// SEO-friendly URL so crawlers only ever see one canonical address.
if (product?.handle && productRef !== product.handle) {
  return Astro.redirect(`/store/${product.handle}`, 301);
}

const {
  title,
  description,
  images,
  options,
  variants,
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
} = product ?? {};

const { cheapestPrice } = getProductPrice({
  productVariants: variants ?? [],
});
---

<Layout
  title={title ?? (error ? t("common.pageNotFound") : undefined)}
  description={description ??
    t("product.metaDescription", { title: title ?? "" })}
  image={images?.[0]?.url}
  type="product"
>
  {
    error && (
      <div class="wrap section">
        <NotFoundNotice asHeading />
      </div>
    )
  }
  {
    product && (
      <div class="wrap grid grid-cols-1 gap-10 pb-16 pt-10 tablet:gap-20 tablet:pt-14 lg:grid-cols-2">
        <ImageCarouselWrapper
          images={images ?? []}
          alt={title ?? t("product.imageAlt")}
        />

        <div class="flex flex-col gap-20">
          <div class="flex flex-col gap-4">
            <h1 class="type-display">{title}</h1>
            <p class="text-gray-500">{description}</p>
            <p class="text-4xl font-bold">{cheapestPrice?.calculated_price}</p>
          </div>

          <ProductActions
            options={options ?? []}
            variants={variants ?? []}
            productId={product.id}
            regionId={region.id}
            locale={locale}
            client:visible
          />

          <ProductAttributes
            material={material}
            origin_country={origin_country}
            type={type}
            weight={weight}
            length={length}
            width={width}
            height={height}
            locale={locale}
          />
        </div>
      </div>
    )
  }
</Layout>
