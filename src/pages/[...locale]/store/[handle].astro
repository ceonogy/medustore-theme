---
import { useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { retrieveProduct } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { getProductPrice } from "@lib/utils/get-product-price";
import ImageCarouselWrapper from "@modules/products/components/product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "@modules/products/components/product-details/ProductActions";
import ProductAttributes from "@modules/products/components/product-details/ProductAttributes.astro";

const { locale, countryCode } = Astro.locals;
// The route segment is the product's SEO handle, e.g. `/store/ao-so-mi-caro-co-dien`.
const { handle: productRef } = Astro.params;
const t = useTranslations(locale);

if (!productRef) {
  return Astro.redirect("/not-found");
}

const region = await getRegion(countryCode);

if (!region) {
  return Astro.redirect("/not-found");
}

let product: Awaited<ReturnType<typeof retrieveProduct>> | undefined;
let error: Error | undefined;

try {
  product = await retrieveProduct(productRef, region.id);
} catch (e) {
  error = e instanceof Error ? e : new Error(t("common.unknownError"));
  Astro.response.status = 404;
  console.error(error);
}

// Links published with the raw id keep working — permanently moved onto the
// SEO-friendly URL so crawlers only ever see one canonical address.
if (product?.handle && productRef !== product.handle) {
  return Astro.redirect(`/store/${product.handle}`, 301);
}

const {
  title,
  description,
  images,
  options,
  variants,
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
} = product ?? {};

const { cheapestPrice } = getProductPrice({
  productVariants: variants ?? [],
});
---

<Layout
  title={title}
  description={description ??
    t("product.metaDescription", { title: title ?? "" })}
  image={images?.[0]?.url}
  type="product"
>
  {error && <p class="text-red-700">{error.message}</p>}
  {
    product && (
      <div class="wrap grid grid-cols-1 gap-10 pb-16 pt-10 tablet:gap-20 tablet:pt-14 lg:grid-cols-2">
        <ImageCarouselWrapper
          images={images ?? []}
          alt={title ?? t("product.imageAlt")}
        />

        <div class="flex flex-col gap-20">
          <div class="flex flex-col gap-4">
            <h1 class="type-display">{title}</h1>
            <p class="text-gray-500">{description}</p>
            <p class="text-4xl font-bold">{cheapestPrice?.calculated_price}</p>
          </div>

          <ProductActions
            options={options ?? []}
            variants={variants ?? []}
            productId={product.id}
            regionId={region.id}
            locale={locale}
            client:visible
          />

          <ProductAttributes
            material={material}
            origin_country={origin_country}
            type={type}
            weight={weight}
            length={length}
            width={width}
            height={height}
            locale={locale}
          />
        </div>
      </div>
    )
  }
</Layout>
