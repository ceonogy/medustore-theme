---
import type { HttpTypes } from "@medusajs/types";
import { localizePath, useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { listProducts } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { listPromotions } from "@lib/data/promotions";
import { breadcrumbJsonLd, itemListJsonLd } from "@lib/utils/seo";
import JsonLd from "@modules/layout/components/JsonLd.astro";
import ProductSlider from "@modules/products/components/product-slider/ProductSlider.astro";
import Countdown from "@modules/ui/components/Countdown.astro";

/**
 * `/khuyen-mai` — every live promotion (active price list inside its time
 * window, from the custom `GET /store/promotions` route) rendered as its own
 * section: title, countdown to the deadline and a horizontally scrollable
 * product slider. The per-promotion listing still lives at
 * `/khuyen-mai/{slug}` for "view all".
 */
const { locale, countryCode } = Astro.locals;
const t = useTranslations(locale);

/** Upper bound on cards per slider — keeps the page weight predictable. */
const MAX_PRODUCTS_PER_PROMOTION = 8;

const unavailable = () =>
  new Response(t("common.serviceUnavailable"), {
    status: 503,
    headers: {
      "Retry-After": "30",
      "Content-Type": "text/plain; charset=utf-8",
    },
  });

let promotions: Awaited<ReturnType<typeof listPromotions>>;
try {
  promotions = await listPromotions();
} catch (error) {
  console.error(error);
  return unavailable();
}

// One catalogue fetch feeds every slider. A failure here only empties the
// sliders; the campaign headings and countdowns still render.
let products: HttpTypes.StoreProduct[] = [];
if (promotions.length) {
  try {
    const region = await getRegion(countryCode);
    if (region) products = await listProducts(region.id);
  } catch (error) {
    console.error(error);
  }
}
const productById = new Map(products.map((product) => [product.id, product]));

const formatDate = (value: string | null): string | undefined => {
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return undefined;
  return new Intl.DateTimeFormat(locale, {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
};

const sections = promotions.map((promotion) => {
  const startsAt = formatDate(promotion.starts_at);
  const endsAt = formatDate(promotion.ends_at);
  const dateLine =
    startsAt || endsAt
      ? [
          startsAt && `${t("promotions.startsAt")}: ${startsAt}`,
          endsAt && `${t("promotions.endsAt")}: ${endsAt}`,
        ]
          .filter(Boolean)
          .join(" · ")
      : undefined;

  return {
    id: promotion.id,
    title: promotion.title,
    description: promotion.description,
    href: localizePath(locale, `/khuyen-mai/${promotion.slug}`),
    endsAtIso: promotion.ends_at,
    dateLine,
    count: promotion.product_ids.length,
    products: promotion.product_ids
      .map((id) => productById.get(id))
      .filter((product): product is HttpTypes.StoreProduct => Boolean(product))
      .slice(0, MAX_PRODUCTS_PER_PROMOTION),
  };
});

const origin = Astro.site?.origin ?? Astro.url.origin;
const structuredData = [
  breadcrumbJsonLd(
    [
      { name: t("products.breadcrumb.home"), path: "/" },
      { name: t("promotions.title"), path: "/khuyen-mai" },
    ],
    origin,
  ),
  ...(sections.length
    ? [
        itemListJsonLd(
          sections.map((section) => ({
            name: section.title,
            path: section.href,
          })),
          origin,
        ),
      ]
    : []),
];
---

<Layout
  title={t("promotions.title")}
  description={t("promotions.metaDescription")}
>
  <JsonLd data={structuredData} />
  <div class="wrap overflow-x-clip pt-6 pb-16 tablet:pt-8 tablet:pb-20">
    {
      /* The header menu already names this page; keep the h1 for crawlers and
        screen readers instead of repeating a visible title + intro above the
        first campaign. */
    }
    <h1 class="sr-only">{t("promotions.title")}</h1>

    {
      sections.length === 0 ? (
        <p class="text-gray-600">{t("promotions.empty")}</p>
      ) : (
        <div class="flex min-w-0 flex-col gap-8 tablet:gap-10">
          {sections.map((section) => (
            <section
              aria-labelledby={`promo-${section.id}`}
              class="min-w-0 overflow-hidden rounded-2xl border border-line bg-fog/40 p-4 tablet:p-5"
            >
              <div class="mb-5 flex flex-col gap-4 tablet:flex-row tablet:items-end tablet:justify-between">
                <div class="min-w-0">
                  <h2 id={`promo-${section.id}`} class="type-title text-left">
                    {section.title}
                  </h2>
                  {section.description && (
                    <p class="mt-1.5 max-w-2xl text-sm text-gray-600 tablet:text-base">
                      {section.description}
                    </p>
                  )}
                  {section.dateLine && (
                    <p class="mt-1.5 text-xs text-muted tablet:text-sm">
                      {section.dateLine}
                    </p>
                  )}
                </div>

                <div class="flex flex-col gap-3 tablet:flex-row tablet:items-end tablet:justify-end">
                  {section.endsAtIso && (
                    <Countdown
                      endsAt={section.endsAtIso}
                      locale={locale}
                      compact
                    />
                  )}
                  <a
                    href={section.href}
                    class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium underline-offset-4 hover:underline"
                  >
                    {t("promotions.viewAll", { count: section.count })}
                    <span
                      aria-hidden="true"
                      class="transition-transform duration-300 group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </a>
                </div>
              </div>

              {section.products.length > 0 ? (
                <ProductSlider
                  products={section.products}
                  label={section.title}
                />
              ) : (
                <p class="text-gray-600">{t("promotions.noProducts")}</p>
              )}
            </section>
          ))}
        </div>
      )
    }
  </div>
</Layout>
