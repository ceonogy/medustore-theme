---
import { localizePath, useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";
import { buildListing, type CatalogListing } from "@lib/data/catalog";
import { getRegion } from "@lib/data/regions";
import { findPromotion, type Promotion } from "@lib/data/promotions";
import { breadcrumbJsonLd, itemListJsonLd } from "@lib/utils/seo";
import JsonLd from "@modules/layout/components/JsonLd.astro";
import NotFoundNotice from "@modules/layout/components/NotFoundNotice.astro";
import ProductListing from "@modules/products/components/product-listing/ProductListing.astro";
import Countdown from "@modules/ui/components/Countdown.astro";

/**
 * `/khuyen-mai/{slug-from-title}` — the slug is derived on the backend from
 * the price list title, so a rename simply moves the page to its new URL.
 * Unknown slugs are a real 404; a promotion whose window has closed stops
 * existing in the same breath (its prices stop applying too).
 */
const { slug } = Astro.params;
const { locale, countryCode } = Astro.locals;
const t = useTranslations(locale);

const unavailable = () =>
  new Response(t("common.serviceUnavailable"), {
    status: 503,
    headers: {
      "Retry-After": "30",
      "Content-Type": "text/plain; charset=utf-8",
    },
  });

let promotion: Promotion | null = null;
try {
  promotion = slug ? await findPromotion(slug) : null;
} catch (error) {
  console.error(error);
  return unavailable();
}

let listing: CatalogListing | null = null;
let description: string | undefined;

if (!promotion) {
  Astro.response.status = 404;
} else {
  try {
    const region = await getRegion(countryCode);
    if (!region) throw new Error(`No region resolves market "${countryCode}"`);

    listing = await buildListing(region.id, Astro.url.search, {
      pathProducts: new Set(promotion.product_ids),
      locale,
    });
    if (listing.beyond) Astro.response.status = 404;

    description =
      promotion.description ||
      t("promotions.listingIntro", { name: promotion.title });
  } catch (error) {
    console.error(error);
    return unavailable();
  }
}

const formatDate = (value: string | null): string | undefined => {
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return undefined;
  return new Intl.DateTimeFormat(locale, {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(date);
};

const startsAt = promotion ? formatDate(promotion.starts_at) : undefined;
const endsAt = promotion ? formatDate(promotion.ends_at) : undefined;
const dateLine =
  startsAt || endsAt
    ? [
        startsAt && `${t("promotions.startsAt")}: ${startsAt}`,
        endsAt && `${t("promotions.endsAt")}: ${endsAt}`,
      ]
        .filter(Boolean)
        .join(" · ")
    : undefined;

const showListing = Boolean(promotion && listing && !listing.beyond);
const basePath = promotion ? `/khuyen-mai/${promotion.slug}` : "/khuyen-mai";

const origin = Astro.site?.origin ?? Astro.url.origin;
// Structured data mirrors the visible breadcrumb and the rendered grid.
const structuredData =
  showListing && listing && promotion
    ? [
        breadcrumbJsonLd(
          [
            { name: t("products.breadcrumb.home"), path: "/" },
            { name: t("promotions.title"), path: "/khuyen-mai" },
            { name: promotion.title, path: basePath },
          ],
          origin,
        ),
        itemListJsonLd(
          listing.products.map((product) => ({
            name: product.title,
            path: `/store/${product.handle}`,
          })),
          origin,
        ),
      ]
    : null;
---

<Layout
  title={promotion?.title ?? t("common.pageNotFound")}
  description={description}
  noindex={!showListing}
>
  {structuredData && <JsonLd data={structuredData} />}
  <div class="wrap overflow-x-clip pt-6 pb-16 tablet:pt-8 tablet:pb-20">
    {
      showListing && listing && promotion ? (
        <>
          <nav
            aria-label={t("products.breadcrumb.home")}
            class="mb-4 flex flex-wrap items-center gap-1 text-xs text-gray-500 tablet:text-sm"
          >
            <a
              href={localizePath(locale, "/")}
              class="hover:text-black hover:underline"
            >
              {t("products.breadcrumb.home")}
            </a>
            <span aria-hidden="true">/</span>
            <a
              href={localizePath(locale, "/khuyen-mai")}
              class="hover:text-black hover:underline"
            >
              {t("promotions.title")}
            </a>
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="text-black">
              {promotion.title}
            </span>
          </nav>

          {/* Same compact header as a campaign card on /khuyen-mai: title,
              blurb and dates on the left, countdown on the right. */}
          <header class="mb-6 rounded-2xl border border-line bg-fog/40 p-4 tablet:mb-8 tablet:p-5">
            <div class="flex flex-col gap-4 tablet:flex-row tablet:items-end tablet:justify-between">
              <div class="min-w-0">
                <h1 class="type-title text-left">{promotion.title}</h1>
                <p class="mt-1.5 max-w-2xl text-sm text-gray-600 tablet:text-base">
                  {description}
                </p>
                {dateLine && (
                  <p class="mt-1.5 text-xs text-muted tablet:text-sm">
                    {dateLine}
                  </p>
                )}
              </div>

              {promotion.ends_at && (
                <Countdown
                  endsAt={promotion.ends_at}
                  locale={locale}
                  compact
                  inline
                  class="shrink-0"
                />
              )}
            </div>
          </header>

          <ProductListing
            products={listing.products}
            suggestions={listing.suggestions}
            groups={listing.groups}
            optionLabels={listing.optionLabels}
            state={listing.state}
            pageType="promotion"
            basePath={basePath}
            totalCount={listing.totalCount}
            page={listing.page}
            pageCount={listing.pageCount}
            priceBounds={listing.priceBounds}
          />
        </>
      ) : (
        <NotFoundNotice asHeading />
      )
    }
  </div>
</Layout>
