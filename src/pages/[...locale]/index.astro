---
import { Image } from "astro:assets";
import heroImage from "@assets/hero.png";
import { localizePath, useTranslations } from "@i18n";
import Layout from "@layouts/Layout.astro";

const { locale } = Astro.locals;
const t = useTranslations(locale);
---

<Layout description={t("site.description")} image={heroImage.src}>
  <section
    class="flex items-center gap-12 overflow-hidden px-8 py-10 md:px-12 lg:min-h-[calc(100vh-96px-2rem)] lg:px-16"
  >
    <div class="flex flex-col gap-6 w-full md:flex-1 md:max-w-2xl">
      <h1 class="text-5xl font-bold leading-tight tracking-tight">
        {t("home.eyebrow")}
        <span class="text-nowrap">{t("home.title")}</span>
      </h1>
      <p class="text-gray-500 text-base leading-relaxed">
        {t("home.subtitle")}
      </p>
      <div class="flex items-center gap-4 mt-2">
        <a
          href="https://github.com/Bystrol/astro-medusa-starter"
          target="_blank"
          class="px-6 py-3 bg-black text-white text-sm font-medium rounded-full hover:bg-gray-800 transition-colors"
        >
          {t("home.openGithub")}
        </a>
        <a
          href={localizePath(locale, "/store")}
          class="px-6 py-3 border border-black text-black text-sm font-medium rounded-full hover:bg-gray-100 transition-colors"
        >
          {t("home.browseProducts")}
        </a>
      </div>
    </div>

    <div
      class="relative hidden h-full min-h-[36rem] md:flex md:flex-1 md:items-center md:justify-end"
    >
      <Image
        src={heroImage}
        width={800}
        height={900}
        alt={t("home.imageAlt")}
        widths={[400, 600, 800]}
        sizes="(max-width: 1024px) 50vw, 40vw"
        format="webp"
        quality={80}
        class="pointer-events-none absolute right-[-58%] top-1/2 z-10 h-auto max-h-none w-[66rem] max-w-none -translate-y-1/2 object-contain lg:right-[-64%] lg:w-[82rem] xl:right-[-62%] xl:w-[98rem]"
      />
    </div>
  </section>
</Layout>
